# ==============================================================================
# HR Policy RAG - Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="HR Policy RAG API"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO

# MongoDB Configuration (PyMongo Async API)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=hr_policy_rag
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=50
MONGODB_TIMEOUT_MS=5000

# ChromaDB Configuration (Persistent Local Storage)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Document Storage Configuration
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=26214400
DOCUMENTS_COLLECTION_NAME=documents

# Azure OpenAI & Vector Indexing Configuration
AZURE_OPENAI_ENDPOINT = mock
AZURE_OPENAI_API_KEY= mock
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_CHAT_TEMPERATURE=0.0
AZURE_OPENAI_CHAT_MAX_TOKENS=1024
AZURE_OPENAI_TIMEOUT_SECONDS=30.0
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_BATCH_SIZE=16
CHROMA_CHUNKS_COLLECTION_NAME=hr_policy_chunks

# Retrieval Configuration
DEFAULT_TOP_K=5
DEFAULT_CANDIDATE_POOL_SIZE=20
SIMILARITY_THRESHOLD=0.0

# Reranking & Context Assembly Configuration
RERANK_TOP_K=10
CONTEXT_TOKEN_BUDGET=2000
